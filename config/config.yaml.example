# Sources to add later (need fetcher work, not RSS):
#   - HF Daily Papers (Phase 2)
#   - GitHub releases for curated repos (Phase 2)
#   - YouTube transcripts: Karpathy, Yannic, 3Blue1Brown (Phase 5)
#   - Dwarkesh Podcast transcripts (Phase 5)

# -- arXiv ---------------------------------------------------------------------
# categories: arXiv category codes to search (cs.AI, cs.CL, cs.CV, cs.LG)
# max_results: maximum papers to fetch per run
arxiv:
  categories:
    - "cs.AI"
    - "cs.CL"
    - "cs.CV"
    - "cs.LG"
  max_results: 100

# -- GitHub Releases -----------------------------------------------------------
# Curated list of AI/ML tooling repos to poll for new releases. Each release
# (excluding drafts and prereleases) becomes an article in the Builder section.
# Unauthenticated rate limit: 60 req/hr — plenty for ~15 repos. For larger
# lists, set GITHUB_TOKEN in the environment.
#
# lookback_days: only emit releases newer than this (default 30)
# per_repo: max releases pulled per repo per fetch (default 5)
github_releases:
  lookback_days: 30
  per_repo: 5
  repos:
    # Inference + serving
    - "vllm-project/vllm"
    - "ggml-org/llama.cpp"
    - "ollama/ollama"
    - "huggingface/text-generation-inference"
    # Frameworks + libraries
    - "huggingface/transformers"
    - "langchain-ai/langchain"
    - "stanfordnlp/dspy"
    - "jxnl/instructor"
    - "BerriAI/litellm"
    # Agents + tooling
    - "microsoft/autogen"
    - "crewAIInc/crewAI"
    - "Significant-Gravitas/AutoGPT"
    # Vector / RAG
    - "chroma-core/chroma"
    - "qdrant/qdrant"
    # Apple silicon / local
    - "ml-explore/mlx"

# -- Reddit --------------------------------------------------------------------
# Requires NEWSLETTER_REDDIT_CLIENT_ID and NEWSLETTER_REDDIT_CLIENT_SECRET
# subreddits: list of subreddit names (without r/ prefix)
# min_score: minimum upvote score to include a post
# limit: max posts per subreddit per fetch
reddit:
  subreddits:
    - "MachineLearning"
    - "artificial"
    - "LocalLLaMA"
  min_score: 10
  limit: 25

# -- Twitter/X -----------------------------------------------------------------
# Requires NEWSLETTER_TWITTER_BEARER_TOKEN (API v2)
# query: Twitter search query syntax
# max_results: max tweets per fetch (API max is 100)
twitter:
  query: "(AI OR \"machine learning\" OR LLM OR \"large language model\") lang:en -is:retweet"
  max_results: 50

# -- Topics --------------------------------------------------------------------
# Grouped by category. These are the tags the LLM assigns to each article.
# Users select from these during onboarding. Used for topic_match scoring.
topics:
  research:
    - "NLP"
    - "Computer Vision"
    - "Reinforcement Learning"
    - "ML Theory"
    - "AI Safety"
    - "Multimodal"
    - "Robotics"
    - "AI Agents"
  industry:
    - "LLM APIs"
    - "AI Infrastructure"
    - "AI Startups"
    - "Enterprise AI"
    - "AI Regulation"
    - "Fundraising"
  applied:
    - "Open Source Models"
    - "AI Art"
    - "AI Coding Tools"
    - "AI Hardware"
    - "Tutorials"
  general:
    - "General AI"

# -- Section Weights -----------------------------------------------------------
# Per-role weighting across sections (research/releases/builder/industry/learn).
# Generalizable: any role key is allowed; missing roles fall back to "default".
# Defaults are NEUTRAL (all 1.0) — tune to taste. The code never hardcodes a
# bias; deployments express their own audience profile here.
#
# Multiplied into the personalized score so a role's heavy sections rank higher
# in their digest, light sections lower. Set to 0.0 to fully suppress a section
# for a role.
section_weights:
  default:
    research: 1.0
    releases: 1.0
    builder: 1.0
    industry: 1.0
    learn: 1.0
  # Suggested starting profiles — tune to your audience. Remove any role to
  # fall back to "default" (neutral) weighting.
  student:
    learn: 1.5
    research: 1.2
    industry: 1.0
    builder: 0.9
    releases: 0.8
  industry:
    builder: 1.4
    releases: 1.3
    industry: 1.2
    research: 0.9
    learn: 0.9
  enthusiast:
    releases: 1.3
    builder: 1.2
    industry: 1.0
    research: 1.0
    learn: 1.0

# -- Role Defaults -------------------------------------------------------------
# Default topic selections and source weights for each user role.
# Applied during onboarding as preselected values.
# source_weights: 0-10 scale, where 5 = neutral baseline.
#   >5 boosts articles from that source; <5 suppresses them.
role_defaults:
  student:
    topics: ["NLP", "Computer Vision", "Reinforcement Learning", "ML Theory", "AI Safety", "Open Source Models", "Tutorials"]
    source_weights:
      arxiv: 10
      huggingface: 9
      reddit: 7
      rss: 5
      twitter: 4
      github: 6
  industry:
    topics: ["LLM APIs", "AI Infrastructure", "AI Startups", "Enterprise AI", "AI Regulation", "Fundraising"]
    source_weights:
      rss: 10
      twitter: 9
      github: 7
      reddit: 5
      arxiv: 4
      huggingface: 5
  enthusiast:
    topics: ["NLP", "Open Source Models", "AI Art", "AI Coding Tools", "AI Agents", "Robotics"]
    source_weights:
      reddit: 8
      rss: 7
      huggingface: 7
      github: 7
      arxiv: 6
      twitter: 6
