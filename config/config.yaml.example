  - name: "huggingface_blog"
    url: "https://huggingface.co/blog/feed.xml"
    section: "releases"
    audience_tags: ["industry", "researcher", "enthusiast"]
    quality_weight: 1.3
  - name: "meta_ai_blog"
    url: "https://engineering.fb.com/category/ml-applications/feed/"
    section: "releases"
    audience_tags: ["industry", "researcher"]
    quality_weight: 1.2
  - name: "google_research"
    url: "https://research.google/blog/rss/"  # TODO verify
    section: "releases"
    audience_tags: ["researcher", "industry"]
    quality_weight: 1.3
  - name: "microsoft_research"
    url: "https://www.microsoft.com/en-us/research/feed/"
